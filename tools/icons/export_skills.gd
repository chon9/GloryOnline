extends SceneTree
## ICONS track: dumps every class kit's skills and every status id to res://tools/icons/skills.json, so the icon
## painter (tools/icons/bake.py) is keyed to the real SkillDef ids.
## Run: Godot --headless --path K:/Project/RONGYAO -s res://tools/icons/export_skills.gd

const OUT_PATH: String = "res://tools/icons/skills.json"
const HINT_KEYS: Array[String] = ["element", "visual", "fx", "method", "type", "shape", "kind", "summon"]


func _initialize() -> void:
	_main.call_deferred()


func _main() -> void:
	await process_frame
	var reg: Node = root.get_node_or_null("Registry")
	if reg == null:
		push_error("export_skills: Registry autoload missing")
		quit(1)
		return
	var classes: Array = []
	for kid: String in reg.call("kit_ids"):
		var kit: ClassKit = reg.call("get_kit", kid)
		if kit == null:
			continue
		var skills: Array = []
		var in_bar: Dictionary = {}
		for s: SkillDef in kit.skills:
			in_bar[s.id] = true
			skills.append(_skill_dict(s, true))
		# chain parts (slot 0 press-chain) and summon skills: exported for reference, not part of the 8-icon bar
		for sid: Variant in kit._index:
			if not in_bar.has(sid):
				skills.append(_skill_dict(kit._index[sid], false))
		var passives: Array = []
		for p: Dictionary in kit.passives:
			passives.append({"name_cn": str(p.get("name_cn", "")), "name_en": str(p.get("name_en", "")),
				"desc": str(p.get("desc", ""))})
		classes.append({
			"id": kit.id, "name_cn": kit.name_cn, "name_en": kit.name_en,
			"group_id": kit.group_id, "group_cn": kit.group_cn, "group_en": kit.group_en,
			"role": kit.role, "weapon_type": kit.weapon_type,
			"weapon_name_cn": kit.weapon_name_cn, "weapon_name_en": kit.weapon_name_en,
			"offhand": kit.offhand, "tint": kit.tint.to_html(false), "famous": kit.famous,
			"skills": skills, "passives": passives,
		})
	var statuses: Array = []
	for i: int in StatusSet.IDS.size():
		var sid: StringName = StatusSet.IDS[i]
		statuses.append({"id": str(sid), "bit": i, "negative": StatusSet.NEGATIVE.has(sid),
			"disabling": StatusSet.DISABLING.has(sid), "dot": StatusSet.DOTS.has(sid)})
	var out := {"_doc": "Generated by tools/icons/export_skills.gd from the live class kits. Do not hand-edit.",
		"classes": classes, "statuses": statuses}
	var f := FileAccess.open(OUT_PATH, FileAccess.WRITE)
	if f == null:
		push_error("export_skills: cannot write " + OUT_PATH)
		quit(1)
		return
	f.store_string(JSON.stringify(out, " ", false))
	f.close()
	print("export_skills: %d classes, %d statuses -> %s" % [classes.size(), statuses.size(), OUT_PATH])
	quit(0)


func _skill_dict(s: SkillDef, in_bar: bool) -> Dictionary:
	var hints: Dictionary = {}
	var status_ids: Dictionary = {}
	for st: Dictionary in s.steps:
		_walk(st, hints, status_ids)
	var hint_out: Dictionary = {}
	for k: String in hints:
		var arr: Array = (hints[k] as Dictionary).keys()
		arr.sort()
		hint_out[k] = arr
	var sts: Array = status_ids.keys()
	sts.sort()
	return {
		"id": str(s.id), "icon_file": str(s.id).replace(".", "__"), "slot": s.slot, "in_bar": in_bar,
		"ultimate": s.is_ultimate(), "name_cn": s.name_cn, "name_en": s.name_en, "desc": s.desc,
		"tags": Array(s.tags), "anim": str(s.anim), "range": s.range, "hints": hint_out, "statuses": sts,
	}


func _walk(v: Variant, hints: Dictionary, status_ids: Dictionary) -> void:
	if v is Dictionary:
		var d: Dictionary = v
		if d.has("id") and d.has("dur"):
			status_ids[str(d["id"])] = true
		for k: Variant in d:
			var key := str(k)
			var val: Variant = d[k]
			if HINT_KEYS.has(key) and (val is String or val is StringName):
				if not hints.has(key):
					hints[key] = {}
				(hints[key] as Dictionary)[str(val)] = true
			elif key == "name" and str(d.get("type", "")) == "vfx":
				if not hints.has("vfx"):
					hints["vfx"] = {}
				(hints["vfx"] as Dictionary)[str(val)] = true
			if val is Dictionary or val is Array:
				_walk(val, hints, status_ids)
	elif v is Array:
		for e: Variant in v:
			_walk(e, hints, status_ids)
